{
    "name": "jankx/woocommerce",
    "description": "WooCommerce integration for Jankx Post Layout",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jankx\\WooCommerce\\": "includes/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite 'Unit Tests'",
        "test:integration": "phpunit --testsuite 'Integration Tests'",
        "test:feature": "phpunit --testsuite 'Feature Tests'",
        "test:coverage": "phpunit --coverage-html tests/coverage/html",
        "stan": "phpstan analyse --memory-limit=2G",
        "cs": "phpcs --standard=PSR12 includes/",
        "cs:fix": "phpcbf --standard=PSR12 includes/"
    }
}
